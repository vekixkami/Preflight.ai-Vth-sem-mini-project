# Copy to .env and edit. Load it with:
#   uvicorn main:app --host 127.0.0.1 --port 8000 --env-file .env

# "production" refuses to fall back to the built-in development tokens.
PREFLIGHT_ENV=development

# Comma-separated token:org_id:plan entries (plan: starter | growth | business).
# Generate tokens with:  python -c "import secrets; print('tok_' + secrets.token_urlsafe(24))"
# If unset outside production, local development tokens from auth.py are used.
PREFLIGHT_API_TOKENS=tok_replace_me:org_example:growth

# Extra browser origins allowed by CORS (comma-separated). The extension and
# localhost dashboards are always allowed; leave empty if you need nothing else.
PREFLIGHT_CORS_ORIGINS=

# Sensitive Layer 2 labels below this confidence are treated as low risk.
PREFLIGHT_MIN_CONFIDENCE=0.20

# SQLite file for telemetry (default: backend/preflight_monitoring.sqlite3).
# PREFLIGHT_DB_PATH=
